{
  "multipart": [
    {
      "apply": {
        "model": "nordic:block/slantedfence_post"
      }
    },
    {
      "apply": {
        "model": "nordic:block/slantedfence_side"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "nordic:block/slantedfence_side",
        "y": 270
      },
      "when": {
        "east": "true"
      }
    }
  ]
}